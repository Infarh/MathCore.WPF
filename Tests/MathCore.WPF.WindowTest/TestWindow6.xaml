<Window x:Class="MathCore.WPF.WindowTest.TestWindow6"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MathCore.WPF.WindowTest"
        xmlns:vm="clr-namespace:MathCore.WPF.WindowTest.ViewModels"
        mc:Ignorable="d"
        DataContext="{vm:TestWindow6ViewModel}"
        Title="{Binding Title}"
        Width="800" Height="450">
    <Window.Resources>
        <!-- Тёмный стиль для главного меню -->
        <Style TargetType="Menu" BasedOn="{StaticResource {x:Type Menu}}">
            <Setter Property="Background" Value="#333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/>
        </Style>

        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#444"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <Grid>
                                <ContentPresenter Content="{TemplateBinding Header}"/>
                                <Popup x:Name="PART_Popup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                    <Border Background="#444" BorderBrush="#555" BorderThickness="1">
                                        <ScrollViewer CanContentScroll="True" Background="#444">
                                            <StackPanel Background="#444">
                                                <ItemsPresenter/>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#555"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#666"/>
                </Trigger>
                <Trigger Property="IsSubmenuOpen" Value="True">
                    <Setter Property="Background" Value="#555"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <DockPanel>
            <Menu ToolTip="123">
                <MenuItem Header="File">
                    <MenuItem Header="Exit" Command="{CloseWindow}"/>
                </MenuItem>
                <MenuItem Header="Help">
                    <MenuItem Header="About"/>
                </MenuItem>
            </Menu>
            <Ribbon DockPanel.Dock="Top">
                <Ribbon.ApplicationMenu>
                    <RibbonApplicationMenu AuxiliaryPaneContent="123" FooterPaneContent="321">
                        <RibbonMenuItem Header="123"/>
                    </RibbonApplicationMenu>
                </Ribbon.ApplicationMenu>
                <RibbonTab Header="{Binding Student.Patronymic}">
                    <RibbonGroup Header="{Binding Student.Group}">
                        <RibbonButton Label="{Binding Student.LastName}"/>
                        <RibbonButton Label="{Binding Student.FirstName}"/>
                    </RibbonGroup>
                </RibbonTab>
            </Ribbon>
            <Grid>
                <ToggleButton Margin="10" VerticalAlignment="Top" HorizontalAlignment="Left"
                              Width="150" Height="30" 
                              Content="{Binding Student.LastName}"
                              Style="{StaticResource ToggleMenuButton}">
                    <ToggleButton.Tag>
                        <DockPanel>
                            <Label Content="Name"/>
                            <Button DockPanel.Dock="Right" Content="Ok" Padding="20,0" Margin="5,0"/>
                            <TextBox Width="300" VerticalContentAlignment="Center" Padding="5"/>
                        </DockPanel>
                    </ToggleButton.Tag>
                </ToggleButton>
                <Border VerticalAlignment="Top" HorizontalAlignment="Left" CornerRadius="4"
                        BorderThickness="1" BorderBrush="Gray" Margin="10,50,0,0"
                        Width="300" Padding="5">
                    <Grid Name="StudentEditForm" DataContext="{Binding Student}">
                        <Grid.BindingGroup>
                            <BindingGroup />
                        </Grid.BindingGroup>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <Label Grid.Column="0" Grid.Row="0" Content="Фамилия"/>
                        <Label Grid.Column="0" Grid.Row="1" Content="Имя"/>
                        <Label Grid.Column="0" Grid.Row="2" Content="Отчество"/>
                        <Label Grid.Column="0" Grid.Row="3" Content="Возраст"/>
                        <Label Grid.Column="0" Grid.Row="4" Content="Группа"/>

                        <TextBox Grid.Column="1" Grid.Row="0" Text="{Binding LastName}"/>
                        <TextBox Grid.Column="1" Grid.Row="1" Text="{Binding FirstName}"/>
                        <TextBox Grid.Column="1" Grid.Row="2" Text="{Binding Patronymic}"/>
                        <TextBox Grid.Column="1" Grid.Row="3" Text="{Binding Age}"/>
                        <TextBox Grid.Column="1" Grid.Row="4" Text="{Binding Group}"/>
                        
                        <UniformGrid Grid.Column="0" Grid.Row="5" Grid.ColumnSpan="2" Rows="1" Margin="0,10,0,0">
                            <Button Content="Ok" Padding="20,5" Margin="5,0"
                                    Command="{Binding SaveCommand}"
                                    CommandParameter="{Binding BindingGroup, ElementName=StudentEditForm}"/>
                            <Button Content="Cancel" Padding="20,5" Margin="5,0"
                                    Command="{Binding CancelCommand}"
                                    CommandParameter="{Binding BindingGroup, ElementName=StudentEditForm}"/>
                        </UniformGrid>
                    </Grid>
                </Border>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
