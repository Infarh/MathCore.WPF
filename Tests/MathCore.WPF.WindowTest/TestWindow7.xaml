<Window x:Class="MathCore.WPF.WindowTest.TestWindow7"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:l="clr-namespace:MathCore.WPF.WindowTest"
        xmlns:vm="clr-namespace:MathCore.WPF.WindowTest.ViewModels"
        DataContext="{vm:TestWindow7ViewModel}"
        Title="{Binding Title}"
        Width="800" Height="450">
    <Grid Margin="5">
        <ListBox ItemsSource="{Binding Events}" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Time, StringFormat=HH:mm:ss, UpdateSourceTrigger=Explicit}"/>
                            <TextBlock Text="{Binding Time, StringFormat=dd.MMM, ConverterCulture=ru-ru, UpdateSourceTrigger=Explicit}" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding Time, StringFormat=yyyy г., UpdateSourceTrigger=Explicit}" HorizontalAlignment="Right"/>
                        </StackPanel>

                        <Border Grid.Column="1" BorderThickness="3,0,0,0" Margin="5,-2" BorderBrush="DarkBlue"/>
                        <HeaderedContentControl Grid.Column="2">
                            <HeaderedContentControl.Header>
                               <TextBlock Text="{Binding Title}" FontWeight="Bold"/>
                            </HeaderedContentControl.Header>
                            <TextBlock Text="{Binding Description}" Margin="5,0,0,0"/>
                        </HeaderedContentControl>
                        <Ellipse Panel.ZIndex="10" Grid.Column="0" HorizontalAlignment="Left" StrokeThickness="2"
                                 Visibility="Collapsed"
                                 Width="15" Height="15" Fill="OrangeRed"
                                 Stroke="Red"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
