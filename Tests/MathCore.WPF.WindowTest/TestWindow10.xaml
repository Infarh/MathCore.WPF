<Window x:Class="MathCore.WPF.WindowTest.TestWindow10"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MathCore.WPF.WindowTest.ViewModels"
        xmlns:wpf="clr-namespace:MathCore.WPF.Controls;assembly=MathCore.WPF"
        Title="{Binding Title}"
        Width="1020" Height="620"
        Background="#20242C">
    <Window.DataContext>
        <vm:TestWindow10ViewModel />
    </Window.DataContext>

    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Направление:" Foreground="WhiteSmoke" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Width="220"
                      ItemsSource="{Binding Directions}"
                      SelectedItem="{Binding FlowDirection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <wpf:SpectrumWaterfallControl
            CurrentSpectrum="{Binding CurrentSpectrum}"
            WaterfallDirection="{Binding FlowDirection}"
            AmplitudeMinimum="{Binding AmplitudeMinimum}"
            AmplitudeMaximum="{Binding AmplitudeMaximum}"
            FrequencyMinimum="{Binding FrequencyMinimum}"
            FrequencyMaximum="{Binding FrequencyMaximum}"
            FrequencyUnit="{Binding FrequencyUnit}"
            TimeUnit="{Binding TimeUnit}"
            TimeStep="{Binding TimeStep}"
            PlotBackground="#0D1117"
            GridLineBrush="#4A5768"
            GridLineThickness="0.75"
            AxisBrush="#DFE8F3"
            AxisThickness="1.1"
            Foreground="#E5EDF7"
            FontSize="11"
            HorizontalGridDivisions="8"
            VerticalGridDivisions="10"/>
    </DockPanel>
</Window>
