// Параметры: width, height (размеры изображения в пикселях)
// Назначение: преобразование диапазона видеозначений с ограниченного (16-235) на полный (0-255)
// для видео стандартов SD и HD

sampler s0 : register(s0);

#define const_1 ( 16.0 / 255.0)
#define const_2 (255.0 / 219.0)

float4 main(float2 tex : TEXCOORD0) : COLOR {
	// исходный пиксель
	float4 c0 = tex2D(s0, tex);

	return ((c0 - const_1) * const_2);
}
