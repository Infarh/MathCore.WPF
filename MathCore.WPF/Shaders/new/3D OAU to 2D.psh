// Параметры: width, height (размеры изображения в пикселях)
// Назначение: преобразование 3D видео OverAndUnder (верхний и нижний кадры) в 2D изображение
// Функция: выбирает верхний кадр в качестве итогового результата

sampler s0 : register(s0);
float4 p0 : register(c0);

#define width (p0[0])
#define height (p0[1])

float4 main(float2 tex : TEXCOORD0) : COLOR
{	
   tex.y = tex.y / 2;

   float4 l = tex2D(s0, tex);

   float red = l.r;
   float green = l.g;
   float blue = l.b;
   
   return float4(red, green, blue, 1);
}